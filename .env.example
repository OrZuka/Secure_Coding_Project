# Copy this file to .env and fill in your own values. .env is gitignored — never commit it.
# The app auto-loads .env on startup (see core.py). These override nothing else; they are
# only read when mail.mode is "smtp" in config.json.

# Brevo SMTP login (shown in Brevo -> SMTP & API -> SMTP). Not secret.
COMMUNICATION_LTD_SMTP_USER=xxxxxx@smtp-brevo.com

# Brevo SMTP key (generated in the same panel). SECRET — keep it only here, never commit.
COMMUNICATION_LTD_SMTP_PASS=

# Any stable random string; keeps login sessions valid across app restarts.
COMMUNICATION_LTD_SECRET=change-me-to-a-random-string
